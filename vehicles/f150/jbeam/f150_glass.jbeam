"sdd_trx2_windshield": {
    "information":{
        "authors":"BeamNG",
        "name":"Windshield",
        "value":350,
    },
    "slotType" : "sdd_trx2_windshield",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         //glass
         {"deformGroup":"windshield_break", "deformMaterialBase":"bastion_glass", "deformMaterialDamaged":"bastion_windshield_dmg"},
         ["sdd_raptR_windshield", ["sdd_trx2_windshield"],[]{"deformSound":"event:>Destruction>Vehicle>Glass>impact_glass_windscreen_01", "deformVolume":0.7}],
         {"deformGroup":"windshield_break", "deformMaterialBase":"bastion_glass_int", "deformMaterialDamaged":"bastion_glass_int"},
         ["sdd_raptR_windshield_int", ["sdd_trx2_windshield"]],

         {"deformGroup":"windshield_break", "deformMaterialBase":"glass_invisible", "deformMaterialDamaged":"glass_mirror"},
         ["sdd_raptR_windshield_dmg", ["sdd_trx2_windshield"]],

         {"deformGroup":""},
         ["sdd_raptR_wipers", ["sdd_trx2_body"]],
    ],
    "sounds": {
        "$+cabinFilterCoef": 0.12
    },
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"selfCollision":true},
         {"collision":true},
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_GLASS"},
         {"nodeWeight":1.88},
         {"group":["sdd_trx2_windshield","gps"]},
         ["wi1", 0.00000, -0.72264, 1.51909],
         {"group":""},
         {"nodeMaterial":"|NM_METAL"},

         //add weight

         //roof
         {"group":"sdd_trx2_body"},
         {"nodeWeight":2.8},
         ["rf1r", -0.70527, -0.28036, 1.67359, {"group":["sdd_trx2_body","sdd_trx2_windshield","gps"]}],
         ["rf1", 0.00000, -0.40871, 1.69908, {"group":["sdd_trx2_body","sdd_trx2_windshield","gps"]}],
         ["rf1l", 0.70527, -0.28036, 1.67359, {"group":["sdd_trx2_body","sdd_trx2_windshield","gps"]}],
         {"nodeWeight":1.5},
         ["rfc1r", -0.35000, -0.39371, 1.68408, {"group":["sdd_trx2_body","sdd_trx2_windshield","gps"]}],
         ["rfc1l", 0.35000, -0.39371, 1.68408, {"group":["sdd_trx2_body","sdd_trx2_windshield","gps"]}],

         //a-pillar
         {"nodeWeight":2.256},
         ["p1r", -0.63000, -0.64756, 1.48500, {"group":["sdd_trx2_body","sdd_trx2_windshield","gps"]}],
         ["p1l", 0.63000, -0.64756, 1.48500, {"group":["sdd_trx2_body","sdd_trx2_windshield","gps"]}],
         ["p2r", -0.78000, -0.60000, 1.48000, {"group":["sdd_trx2_body","sdd_trx2_windshield","gps"]}],
         ["p2l", 0.78000, -0.60000, 1.48000, {"group":["sdd_trx2_body","sdd_trx2_windshield","gps"]}],

         //firewall
         {"nodeWeight":5.828},
         ["b6rr", -0.88000, -0.87000, 1.20000, {"group":["sdd_trx2_body","sdd_trx2_windshield","gps","sdd_trx2_snorkel"]}],
         ["b6r", -0.35000, -1.04468, 1.26902, {"group":["sdd_trx2_body","sdd_trx2_windshield","gps"]}],
         ["b6l", 0.35000, -1.04468, 1.26902, {"group":["sdd_trx2_body","sdd_trx2_windshield","gps"]}],
         ["b6ll", 0.88000, -0.87000, 1.20000, {"group":["sdd_trx2_body","sdd_trx2_windshield","gps"]}],
