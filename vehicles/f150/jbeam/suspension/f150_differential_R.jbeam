"sdd_trx2_finaldrive_R_race": {
    "information":{
        "authors":"The_Gamer6000",
        "name":"Race Adjustable Rear Final Drive",
        "value":750,
    },

    "slotType" : "sdd_trx2_finaldrive_R",

    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$finaldrive_R", "range", ":1", "Differentials", 4.10, 2.0, 6.0, "Final Drive Gear Ratio", "Torque multiplication ratio", {"subCategory":"Rear", "stepDis":0.01}],
    ],

    "differential_R" : {
        "gearRatio":"$finaldrive_R",
    },
},
"sdd_trx2_driveshaft_R_crew": {
    "information":{
        "authors":"The_Gamer6000",
        "name":"Crew Rear Driveshaft",
        "value":580,
    },
    "slotType" : "sdd_trx2_driveshaft_R_crew",
    "powertrain" : [
        ["type", "name", "inputName", "inputIndex"],
        //rear driveshaft
        ["torsionReactor", "torsionReactorR", "transfercase", 1, {}],
        ["shaft", "driveshaft", "torsionReactorR", 1, {"breakTriggerBeam":"driveshaft", "uiName":"Rear Driveshaft", "electricsName":"driveshaft", "friction":0.519, "dynamicFriction": 0.00112}],
    ],
    "torsionReactorR": {
        "torqueReactionNodes:":["e1l","e2l","e4r"],
    },
    "props": [
        ["func",       "mesh",                 "idRef:","idX:","idY:", "baseRotation",            "rotation",            "translation",         "min", "max", "offset", "multiplier",],
        ["driveshaft", "sdd_trx2_driveshaft_crew","ax3r","ax3l", "tra1",  {"x":-88.2, "y":0, "z":0}, {"x":0, "y":1, "z":0}, {"x":0.0, "y":0.0, "z":0.0}, -360, 360, 0, 1, {"breakGroup":"driveshaft","deformGroup":"driveshaft","optional":true}],
    ],
    "beams": [
          ["id1:", "id2:"],
          //driveshaft
          {"beamPrecompression":1.0, "beamType":"|BOUNDED", "beamLongBound":0.075, "beamShortBound":0.075},
          {"beamSpring":0,"beamDamp":0,"beamDeform":3535,"beamStrength":4599},
          {"beamLimitSpring":10001000,"beamLimitDamp":1000},
          ["ax3","tra1", {"name":"driveshaft","optional":true,"breakGroup":"driveshaft","deformGroup":"driveshaft"}],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
},
