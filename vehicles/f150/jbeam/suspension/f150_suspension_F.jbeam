{
"sdd_trx2_IFS_offroad": {
    "information":{
        "authors":"The_Gamer6000",
        "name":"BILSTEIN BLACKHAWK e2 Front Suspension",
        "value":4500,
    },
    "slotType" : "pickup_suspension_F",
    "slots": [
        ["type", "default", "description"],
        ["sdd_trx2_coilover_IFS_offroad","sdd_trx2_coilover_IFS_offroad","Front Coilovers"],
        ["sdd_trx2_differential_F","sdd_trx2_differential_F","Front Differential"],
        ["pickup_hub_F","pickup_hub_F_6","Front Wheel Hubs"],
        ["pickup_swaybar_F_offroad","pickup_swaybar_F_offroad","Front Sway Bar"],
        ["pickup_steering_offroad","pickup_steering_offroad","Steering"],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$camber_FR", "range", "", "Wheel Alignment", 0.945, 0.91, 1.04, "Camber Adjust", "Adjusts the wheel camber angle", {"subCategory":"Front"}],
        ["$caster_FR", "range", "", "Wheel Alignment", 1, 1.015, 0.985, "Caster Adjust", "Adjusts forward rake of the steering axis", {"subCategory":"Front"}],
        ["$trackoffset_F", "range", "+m", "Wheels", 0.0, -0.02, 0.05, "Wheel Offset", "Spacing of the wheel from the hub", {"stepDis":0.001,"subCategory":"Front"}],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         //front running gear
       
        
         ["sdd_trx2_subframe_IFS", ["pickup_frame", "pickup_uppermounts", "pickup_lowermounts","pickup_steeringrack"]],
         ["sdd_trx2_subframe_F_brace", ["pickup_frame", "pickup_uppermounts", "pickup_lowermounts","pickup_steeringrack"]],
         ["sdd_trx_liftkit_IFS", ["pickup_frame", "pickup_lowermounts","pickup_steeringrack"]],
		  ["sdd_trx2_lines_F", ["pickup_frame", "pickup_lowermounts","pickup_steeringrack"]],
         ["sdd_trx2_steeringbox", ["pickup_frame", "pickup_lowermounts"]],
         ["sdd_trx2_hub_FR_offroad", ["pickup_hub1_F", "pickup_hub4_F","pickup_hub5_F","pickup_lowerarm_R","pickup_upperarm_F"]],
         ["sdd_trx2_hub_FL_offroad", ["pickup_hub1_F", "pickup_hub4_F","pickup_hub5_F","pickup_lowerarm_L","pickup_upperarm_F"]],
         ["sdd_trx2_lowerarm_offroad", ["pickup_lowerarm_F", "pickup_shockbottom", "pickup_lowermounts"]],
         ["sdd_trx2_upperarm_offroad", ["pickup_upperarm_F", "pickup_uppermounts"]],
    ],
    "nodes": [
