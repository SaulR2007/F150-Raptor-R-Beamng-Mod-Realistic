    }],
    ["buttonForward", "Move Down", "Navigate menu down", {
        "onDown": "electrics.values.menuVertical = -1"
    }],
    ["buttonMiddle", "Select", "Select current item", {
        "onDown": "electrics.values.menuSelect = 1"
    }],
  
