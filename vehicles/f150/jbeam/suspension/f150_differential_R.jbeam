{
"sdd_trx2_differential_R": {
    "information":{
        "authors":"The_Gamer6000",
        "name":"Open Rear Differential",
        "value":450,
    },
    "slotType" : "sdd_trx2_differential_R",
    "slots": [
        ["type", "default", "description"],
        //["sdd_trx2_driveshaft_R","sdd_trx2_driveshaft_R","Rear Driveshaft"],
        ["sdd_trx2_finaldrive_R","sdd_trx2_finaldrive_R_355", "Rear Final Drive", {"coreSlot":true}],
    ],
    "powertrain" : [
        ["type", "name", "inputName", "inputIndex"],
        //rear diff
        ["differential", "differential_R", "driveshaft", 1, {"diffType":"open", "uiName":"Rear Differential","defaultVirtualInertia":0.5}],
    ],
    "differential_R": {
        "friction": 6.6,
        "dynamicFriction": 0.00311,
        "torqueLossCoef": 0.03,
    },
},
