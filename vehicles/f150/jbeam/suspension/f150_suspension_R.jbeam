"sdd_trx2_spring_R": {
    "information":{
        "authors":"The_Gamer6000",
        "name":"Rear Springs",
        "value":850,
    },
    "slotType" : "sdd_trx2_spring_R",
    "powertrainDeviceType":"spring",
    "powertrainDeviceName":"rear_spring",
    "springRateVariable": "$spring_R3",
    "controller": [
      ["fileName"],
      ["activeSprings", {
        "name":"activeRearSpring", 
        "springHydro":"springHydroR", 
        "springBeamNames":["spring_RL", "spring_RR"]}]
    ],
    
    "activeRearSpring": {
      "modes": [
        ["name",   "springLengthCoef", "beamSpringCoef"], // springLengthCoef = travel | beamSpringCoef = stiffness
        ["normal",     0.55,          2.5],
        ["sport",      0.25,          3],
        ["tow",        0.55,          4],
        ["baja",       0.75,          2],
        ["rockcrawl",  0.82,          1.5],
      ]
    },
    
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["sdd_trx2_springtop_F", ["pickup_frame", "pickup_rearshocktop"]],
