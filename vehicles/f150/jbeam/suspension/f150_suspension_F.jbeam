         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         {"collision":true},
         {"selfCollision":true},
         //--FRONT INDEPENDENT SUSPENSION--
         //top of shock/spring
         {"group":"pickup_shocktop"},
