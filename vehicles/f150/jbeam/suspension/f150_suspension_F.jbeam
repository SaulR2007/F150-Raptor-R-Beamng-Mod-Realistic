"sdd_trx2_coilover_IFS_offroad": {
    "information":{
        "authors":"The_Gamer6000",
        "name":"Front BILSTEIN Dual-Valve Coilovers",
        "value":1000,
    },
    "slotType" : "sdd_trx2_coilover_IFS_offroad",

    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["sdd_trx2_coilovers_F", ["pickup_shockbottom","pickup_shocktop"]],
    ],

    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$springheight_F",     "range", "+m",    "Suspension", 0,     -0.1,  0.1,  "Spring Height",     "Raise or lower the suspension height", {"stepDis":0.005, "subCategory":"Front"}],
        ["$spring_F",           "range", "N/m",   "Suspension", 115000, 50000, 200000, "Spring Rate",    "Spring stiffness", {"stepDis":500,"subCategory":"Front"}],
        ["$damp_bump_F",        "range", "N/m/s", "Suspension", 10000,  500,   15000,  "Bump Damping",    "Damper rate in slow compression", {"stepDis":100, "subCategory":"Front"}],
        ["$damp_bump_F_fast",   "range", "N/m/s", "Suspension", 19000,  500,   25000,  "Fast Bump Damping","Damper rate in fast compression", {"stepDis":100, "subCategory":"Front"}],
        ["$damp_rebound_F",     "range", "N/m/s", "Suspension", 10000,  500,   15000,  "Rebound Damping", "Damper rate in extension", {"stepDis":100,"subCategory":"Front"}]
    ],

    // === Make the front coilover an active spring device ===
    "powertrainDeviceType":"spring",
    "powertrainDeviceName":"front_spring",
    "springRateVariable":"$spring_F",

    "controller": [
      ["fileName"],
      ["activeSprings", {
        "name":"activeFrontSpring",
        "springHydro":"springHydroF",
        "springBeamNames":["spring_FL", "spring_FR"]
      }]
    ],

    "activeFrontSpring": {
      "modes": [
        ["name",      "springLengthCoef", "beamSpringCoef"], // springLengthCoef = travel | beamSpringCoef = stiffness
        ["normal",     0.45,          1],
        ["sport",      0.25,          2],
        ["baja",       0.60,          0.65],
        ["rockcrawl",  0.72,          0.5,]
      ]
    },

    "beams": [
          ["id1:", "id2:"],

          // ***** DO NOT put the old 'front springs' here anymore, springs are now in hydros *****

          //front shocks (unchanged)
          {"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamLimitSpring":0,"beamLimitDamp":0},
          {"beamSpring":0,"beamDamp":"$damp_bump_F"},
          ["fh3l","fs1l", {"beamDampRebound":"$damp_rebound_F","beamDampVelocitySplit":0.5,"beamDampFast":"$damp_bump_F_fast","beamDampReboundFast":"$damp_rebound_F","dampCutoffHz":500}],
          ["fh3r","fs1r", {"beamDampRebound":"$damp_rebound_F","beamDampVelocitySplit":0.5,"beamDampFast":"$damp_bump_F_fast","beamDampReboundFast":"$damp_rebound_F","dampCutoffHz":500}],

          //bumpstop (unchanged)
          {"beamSpring":0, "beamDamp":0},
          {"beamLimitSpring":401000,"beamLimitDamp":10000},
          ["fh3l","fs1l", {"longBoundRange":0.22,"shortBoundRange":-0.06,"boundZone":0.04,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          ["fh3r","fs1r", {"longBoundRange":0.22,"shortBoundRange":-0.06,"boundZone":0.04,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":0.5}
    ],

    // === Springs moved to hydros and controlled by activeFrontSpring ===
    "hydros": [
          ["id1:", "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
          {"beamDeform":20000,"beamStrength":150000},
          {"beamSpring":"$spring_F","beamDamp":0},

          // LEFT front coilover spring
          ["fh7l","fs1l", {
              "name":"spring_FL",
              "inputSource":"springHydroF",
              "precompressionRange":0.0,
              "inRate":0.1,
              "outRate":0.05,
              "soundFile":"event:>Vehicle>Suspension>pickup_01>spring_compress_01",
              "colorFactor":0.5,
              "attackFactor":10,
              "volumeFactor":3.6,
              "decayFactor":11,
              "noiseFactor":0.01,
              "pitchFactor":0.4,
              "maxStress":15000
          }],

          // RIGHT front coilover spring
          ["fh7r","fs1r", {
              "name":"spring_FR",
              "inputSource":"springHydroF",
              "precompressionRange":0.0,
              "inRate":0.1,
              "outRate":0.05,
              "soundFile":"event:>Vehicle>Suspension>pickup_01>spring_compress_01",
              "colorFactor":0.5,
              "attackFactor":10,
              "volumeFactor":3.6,
              "decayFactor":11,
              "noiseFactor":0.01,
              "pitchFactor":0.4,
              "maxStress":15000
          }],

          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0}
    ]
},
}